<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Drydock.Testcontainers.Vault</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Drydock.Testcontainers.Vault</PackageId>
    <Title>Drydock: Vault module for Testcontainers for .NET</Title>
    <Description>Community module for Testcontainers for .NET that starts a real HashiCorp Vault or OpenBao dev server for integration tests: known root token, health-based readiness, ordered init commands that fail fast.</Description>
    <Authors>ferhatblnk</Authors>
    <Copyright>Copyright (c) 2026 ferhatblnk</Copyright>
    <PackageTags>testcontainers;vault;hashicorp-vault;openbao;secrets;docker;integration-testing;testing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ferhatblnk/drydock-testcontainers-vault</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ferhatblnk/drydock-testcontainers-vault</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="[$(TestcontainersVersion), 5.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Drydock.Testcontainers.Vault.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
